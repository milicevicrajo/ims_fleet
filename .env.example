# Uzor za .env — kopiraj u .env i popuni stvarnim vrednostima.
# .env se NE upisuje u git.

# Django tajni kljuc. Napravi nov sa:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#%^&*(-_=+)') for _ in range(50)))"
DJANGO_SECRET_KEY=promeni-me

# True samo u razvoju. Pre prebacivanja na False resiti opsluzivanje media/ preko
# web servera — ims_erp/urls.py opsluzuje slike samo kada je DEBUG=True.
DJANGO_DEBUG=True

# Pristup SQL Server bazi
IMS_DB_NAME=IMS_ERP
IMS_DB_USER=
IMS_DB_PASSWORD=
IMS_DB_HOST=
IMS_DB_PORT=
